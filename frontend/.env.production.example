# Abella Stitches - Frontend Environment Variables (Production)
# Add these to your Vercel project environment variables

# Backend API URL
# This should be your Railway/Render backend URL
VITE_API_URL=https://your-backend-app.railway.app

# ===== EMAILJS CONFIGURATION =====
# Get these from https://www.emailjs.com/
# Dashboard → Email Services → Integration

# EmailJS Public Key
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key_here

# EmailJS Service ID
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id_here

# EmailJS Template ID for Contact Form
VITE_EMAILJS_CONTACT_TEMPLATE_ID=your_contact_template_id_here

# EmailJS Template ID for Newsletter Confirmation
VITE_EMAILJS_NEWSLETTER_TEMPLATE_ID=your_newsletter_template_id_here

# ===== NOTES =====
# 1. These variables must be added in Vercel dashboard under Project Settings → Environment Variables
# 2. All variables starting with VITE_ are exposed to the browser
# 3. Never put sensitive keys here (API secrets, passwords, etc.)
# 4. Redeploy after changing environment variables
