# Abella Stitches - Environment Variables Template
# Copy this file to .env and fill in your actual values

# MongoDB Connection
MONGODB_URI=your_mongodb_connection_string_here

# JWT Secret (use a long random string)
JWT_SECRET=your_very_long_random_secret_key_here

# Server Port
PORT=5000

# Frontend URL (for payment redirects and CORS)
FRONTEND_URL=http://localhost:5173

# Paystack Payment Gateway (for Nigerian Naira transactions)
# Sign up at https://paystack.com/ and get your API keys
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key_here

# SMTP Configuration (for order confirmation emails via Nodemailer)
# Option 1: Gmail (enable 2FA and create App Password from Google Account settings)
# Option 2: Use SendGrid, Mailgun, or AWS SES for production
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM=Abella Stitches <your_email@gmail.com>

# Environment
NODE_ENV=development
