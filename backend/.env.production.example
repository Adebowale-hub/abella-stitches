# Abella Stitches - Production Environment Variables Template
# Copy these values to your hosting platform's environment variables section
# DO NOT commit actual values to version control

# ===== CRITICAL: REQUIRED FOR PRODUCTION =====

# MongoDB Atlas Connection String
# Get this from MongoDB Atlas: Database → Connect → Connect your application
MONGODB_URI=mongodb+srv://username:password@cluster.xxxxx.mongodb.net/abellastitches?retryWrites=true&w=majority

# JWT Secret - Generate a strong random string (min 32 characters)
# Generate at: https://www.grc.com/passwords.htm
JWT_SECRET=your_very_long_random_secret_at_least_32_characters_here

# Server Port (Railway/Render will use their own, but set this as fallback)
PORT=5000

# Node Environment
NODE_ENV=production

# Frontend URL - Your Vercel deployment URL
FRONTEND_URL=https://your-app-name.vercel.app

# ===== PAYMENT INTEGRATION =====

# Paystack Secret Key (Live Mode - starts with sk_live_)
# Get from: https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=sk_live_your_actual_paystack_live_secret_key

# ===== EMAIL/SMTP CONFIGURATION =====
# Choose one option below:

# Option 1: Gmail (Development/Small Scale)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_16_character_app_password_here
SMTP_FROM=Abella Stitches <your_gmail@gmail.com>

# Option 2: SendGrid (Recommended for Production - Free: 100 emails/day)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=SG.your_sendgrid_api_key_here
# SMTP_FROM=Abella Stitches <noreply@abellastitches.com>

# Option 3: Mailgun (Free: 5,000 emails/month)
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=postmaster@your-domain.mailgun.org
# SMTP_PASS=your_mailgun_smtp_password
# SMTP_FROM=Abella Stitches <noreply@abellastitches.com>
